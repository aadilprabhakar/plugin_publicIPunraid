<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "publicip">
<!ENTITY author "Aadil P">
<!ENTITY version "2026.03.06">
<!ENTITY description "Displays your server's public IP address on the Unraid dashboard.">
<!ENTITY pluginURL "https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.plg">
<!ENTITY rawBase "https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" icon="globe" min="6.9.0">

<CHANGES>
### 2026.03.06
- Rewrote publicip.js to actually fetch public IP from ipify.org
- Added localStorage caching (5-minute TTL) to reduce API calls
- Added auto-refresh every 5 minutes via setInterval
- Replaced Main.php injection with proper Unraid dashboard tile (.page file)
- Fixed pluginURL to point to actual repository
- Added graceful error handling

### 2026.01.17
- Initial release (simple injection test)
</CHANGES>

<!-- Self-update: keep the .plg file on the boot partition -->
<FILE Name="/boot/config/plugins/&name;.plg" url="&pluginURL;" required="true"/>

<!-- Download the JS file -->
<FILE Name="/boot/config/plugins/&name;/publicip.js" url="&rawBase;/publicip.js" required="true"/>

<!-- Download the dashboard page tile -->
<FILE Name="/boot/config/plugins/&name;/publicip.page" url="&rawBase;/publicip.page" required="true"/>

<!-- Install: copy files into place -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
PLUGIN_DIR="/usr/local/emhttp/plugins/&name;"

echo "--- Installing &name; Plugin ---"

# Create plugin directory
mkdir -p "$PLUGIN_DIR"

# Copy JS and page tile into the emhttp plugin directory
cp "/boot/config/plugins/&name;/publicip.js" "$PLUGIN_DIR/publicip.js"
cp "/boot/config/plugins/&name;/publicip.page" "$PLUGIN_DIR/publicip.page"

chmod 644 "$PLUGIN_DIR/publicip.js"
chmod 644 "$PLUGIN_DIR/publicip.page"

echo "--- &name; Plugin installed successfully ---"
</INLINE>
</FILE>

<!-- Uninstallation script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN_DIR="/usr/local/emhttp/plugins/&name;"

echo "--- Removing &name; Plugin ---"

# Remove the plugin directory entirely
if [ -d "$PLUGIN_DIR" ]; then
  rm -rf "$PLUGIN_DIR"
  echo "Removed plugin directory: $PLUGIN_DIR"
fi

echo "--- &name; Plugin removed successfully ---"
</INLINE>
</FILE>

</PLUGIN>
