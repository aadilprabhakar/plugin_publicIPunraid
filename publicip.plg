<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "publicip">
<!ENTITY author "Aadil P">
<!ENTITY version "2026.03.07">
<!ENTITY pluginURL "https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.plg">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" icon="globe" min="6.9.0">

<CHANGES>
### 2026.03.07
- Downloads js/page files via wget in install script (Unraid 7.x FILE tag downloads require checksums and are unreliable for small plugins)

### 2026.03.06
- Rewrote publicip.js to actually fetch public IP from ipify.org
- Added localStorage caching (5-minute TTL) to reduce API calls
- Added auto-refresh every 5 minutes via setInterval
- Replaced Main.php injection with proper Unraid dashboard tile (.page file)
- Fixed pluginURL to point to actual repository
- Added graceful error handling

### 2026.01.17
- Initial release (simple injection test)
</CHANGES>

<FILE Name="/boot/config/plugins/&name;.plg" url="https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.plg" required="true"/>

<FILE Run="/bin/bash" Method="install">
<INLINE>
BASE="https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main"
PLUGIN_DIR="/usr/local/emhttp/plugins/publicip"
BOOT_DIR="/boot/config/plugins/publicip"

mkdir -p "$PLUGIN_DIR" "$BOOT_DIR"

wget -qO "$PLUGIN_DIR/publicip.js" "$BASE/publicip.js" && echo "Downloaded publicip.js" || echo "ERROR: failed to download publicip.js"
wget -qO "$PLUGIN_DIR/publicip.page" "$BASE/publicip.page" && echo "Downloaded publicip.page" || echo "ERROR: failed to download publicip.page"

cp "$PLUGIN_DIR/publicip.js" "$BOOT_DIR/publicip.js"
cp "$PLUGIN_DIR/publicip.page" "$BOOT_DIR/publicip.page"

chmod 644 "$PLUGIN_DIR/publicip.js" "$PLUGIN_DIR/publicip.page"
</INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -rf "/usr/local/emhttp/plugins/publicip"
</INLINE>
</FILE>

</PLUGIN>
