<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "publicip">
<!ENTITY author "Aadil P">
<!ENTITY version "2026.03.07">
<!ENTITY description "Displays your server's public IP address on the Unraid dashboard.">
<!ENTITY pluginURL "https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.plg">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" icon="globe" min="6.9.0">

<CHANGES>
### 2026.03.07
- Moved file downloads into install script to bypass Unraid 7.x SHA256/MD5 requirement on FILE tags

### 2026.03.06
- Rewrote publicip.js to actually fetch public IP from ipify.org
- Added localStorage caching (5-minute TTL) to reduce API calls
- Added auto-refresh every 5 minutes via setInterval
- Replaced Main.php injection with proper Unraid dashboard tile (.page file)
- Fixed pluginURL to point to actual repository
- Added graceful error handling

### 2026.01.17
- Initial release (simple injection test)
</CHANGES>

<!-- Self-update: keep the .plg file on boot -->
<FILE Name="/boot/config/plugins/&name;.plg" url="https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.plg" required="true"/>

<!-- Download JS file -->
<FILE Name="/boot/config/plugins/&name;/publicip.js" url="https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.js" required="true">
<SHA256>df8ddfee2acd2b774de046068c583651794ae018841f0774676772a62a8eaf3c</SHA256>
</FILE>

<!-- Download dashboard page tile -->
<FILE Name="/boot/config/plugins/&name;/publicip.page" url="https://raw.githubusercontent.com/aadilprabhakar/plugin_publicIPunraid/main/publicip.page" required="true">
<SHA256>ced0a6d42e20754aa52108c59c969dcfe3af9c871142e52ba86dbc63e0fa10b0</SHA256>
</FILE>

<!-- Install: copy files into place -->
<FILE Run="/bin/bash" Method="install">
<INLINE>
PLUGIN_DIR="/usr/local/emhttp/plugins/publicip"
BOOT_DIR="/boot/config/plugins/publicip"

echo "--- Installing publicip Plugin ---"

mkdir -p "$PLUGIN_DIR"

cp "$BOOT_DIR/publicip.js" "$PLUGIN_DIR/publicip.js"
cp "$BOOT_DIR/publicip.page" "$PLUGIN_DIR/publicip.page"

chmod 644 "$PLUGIN_DIR/publicip.js" "$PLUGIN_DIR/publicip.page"

echo "--- publicip Plugin installed successfully ---"
</INLINE>
</FILE>

<!-- Uninstall: remove plugin directory -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
PLUGIN_DIR="/usr/local/emhttp/plugins/publicip"

echo "--- Removing publicip Plugin ---"

rm -rf "$PLUGIN_DIR"
echo "Removed: $PLUGIN_DIR"

echo "--- publicip Plugin removed successfully ---"
</INLINE>
</FILE>

</PLUGIN>
